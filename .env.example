# Copy to .env and fill in. NEVER commit .env. Nothing below is a real key.

# --- LLM providers ---
# Leave a key EMPTY to run without it. With both empty the app still runs: LLM calls return a clearly
# flagged [MOCK] reply and are excluded from evaluation metrics. Do not put placeholder text here - a
# non-empty value is treated as a real key and used.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Langfuse tracing (optional; local logs/traces.jsonl is always written) ---
# Uncomment BOTH keys to enable it. Add LANGFUSE_HOST for self-hosted or a non-default region
# (e.g. https://us.cloud.langfuse.com); the SDK defaults to https://cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional tuning (defaults shown) ---
# Where local trace spans are written.
TRACE_FILE=logs/traces.jsonl
# Embedding model for the semantic cache.
EMBED_MODEL=gemini-embedding-001
# Simulated partner-lab API failure rate, to exercise retry + human handoff (0 disables).
LAB_FAILURE_RATE=0.15
