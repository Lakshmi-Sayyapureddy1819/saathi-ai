# Copy to .env and fill in. NEVER commit .env. Nothing below is a real key.

# --- LLM providers ---
# Leave a key EMPTY to run without it. With both empty the app still runs: LLM calls return a clearly
# flagged [MOCK] reply and are excluded from evaluation metrics. Do not put placeholder text here - a
# non-empty value is treated as a real key and used.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Langfuse tracing (optional; local logs/traces.jsonl is always written) ---
# Uncomment BOTH keys to enable it. Add LANGFUSE_HOST for self-hosted or a non-default region
# (e.g. https://us.cloud.langfuse.com); the SDK defaults to https://cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
# At startup the keys are verified once (a few seconds at most). If Langfuse rejects them it is switched OFF with a clear
# warning and local tracing continues. Set LANGFUSE_AUTH_CHECK=0 to skip the check (e.g. offline).
# LANGFUSE_AUTH_CHECK=1

# --- Optional tuning (defaults shown) ---
# Where local trace spans are written.
TRACE_FILE=logs/traces.jsonl
# Embedding model for the semantic cache.
EMBED_MODEL=gemini-embedding-001
# Simulated partner-lab API failure rate, to exercise retry + human handoff (0 disables).
LAB_FAILURE_RATE=0

# Privacy: keep this false. Members' messages can contain health data; when false, prompts/replies/queries are sent to
# Langfuse and written to logs/traces.jsonl as <redacted len=N tag=...> only. true sends raw text (demo use only).
LANGFUSE_CAPTURE_CONTENT=false

# Semantic cache: entries expire this many seconds after they are stored (0 = never). Default 3600.
SEMANTIC_CACHE_TTL_SECONDS=3600
# Semantic cache similarity threshold (cosine similarity). Default 0.88 (conservative to ensure 0% false hits).
SEMANTIC_CACHE_THRESHOLD=0.88
# Optional shared cache with native key expiry. Leave empty to use the in-process cache. Redis stores only embeddings
# and generic answers, never member question text. Example: redis://localhost:6379/0  (or rediss://... with a password)
REDIS_URL=

# --- Program Coach grounding (brief section 2) ---
# mode_a_rag (default): agentic RAG, an agent decides whether/what to retrieve from the program library and cites sources.
# mode_b_facts: no retrieval; the agent calls backend tools (profile, bookings, schedule, catalogue) and answers only
# from the returned facts, else "I don't have that information".
GROUNDING_MODE=mode_a_rag
# 1 (default): a small planner LLM call makes the retrieve / tool choice. 0: deterministic rules, no extra LLM call.
AGENTIC_GROUNDING=1
# Mode A retrieval backend: lexical (default; no index, no network) or embedding (dense, in-memory index built lazily with
# EMBED_MODEL, falls back to lexical if embeddings are unavailable). The floor rejects off-topic queries; 0.6 was picked
# with `python -m evaluations.retriever_compare`.
RETRIEVER=lexical
EMBED_RETRIEVAL_MIN_SCORE=0.6

# ================= Production (APP_ENV=production refuses to start while anything below is simulated) =================
# APP_ENV=production
# DATABASE_URL=sqlite:///data/saathi.db           # members, bookings, sessions, alert audit trail (keep on an encrypted volume)
# FRONTEND_ORIGINS=https://app.example.com
# COORDINATOR_TOKEN=<long random secret>
# ALLOW_MOCK_LLM=0                                 # 1 only for tests/offline demos; with no API key members get an honest "unavailable" reply
# ALLOW_SIMULATORS=0                               # explicit override to run the simulated lab partner / log-only alerts
# Lab partner (HTTP adapter contract in app/tools/lab_backend.py):
# LAB_BACKEND=http
# LAB_API_URL=https://partner.example.com/api
# LAB_API_KEY=<partner key>
# Free emergency alert channels (any combination; all configured channels are used):
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_CHAT_ID=<care-team chat/group id>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<gmail app password>
# ALERT_EMAIL_FROM=you@gmail.com
# ALERT_EMAIL_TO=oncall@example.com
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM= / ALERT_SMS_TO=       # optional SMS (trial accounts are free)
# Bundled lab scheduling service (python -m services.lab_partner): uses the same LAB_API_KEY as the bearer token.
# LAB_PARTNER_PORT=8100
# LAB_PARTNER_DB=data/lab_partner.db
