# Rendered by the nginx image's entrypoint (envsubst, only for variables defined in the container environment).
#   ORIGIN_VERIFY  shared secret CloudFront adds as the X-Origin-Verify header. Empty => no check (local compose only).
#   BACKEND_HOST   host:port of the FastAPI container.
server_tokens off;

server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 64k;            # chat messages are <= 500 chars; nothing here accepts uploads

    # Liveness for the host and for local tests. Not behind the origin check, reveals nothing.
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # API: reverse proxy. 60 s matches CloudFront's maximum origin read timeout (a slow LLM turn can take ~30 s).
    location /api/ {
        if ($http_x_origin_verify != "${ORIGIN_VERIFY}") { return 403; }
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Hashed build assets: cache for a year.
    location /assets/ {
        if ($http_x_origin_verify != "${ORIGIN_VERIFY}") { return 403; }
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA shell: never cached, so a new deploy is picked up immediately.
    location / {
        if ($http_x_origin_verify != "${ORIGIN_VERIFY}") { return 403; }
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
